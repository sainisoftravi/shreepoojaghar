generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id        String    @id @default(uuid())
  nameEn    String    @map("name_en")
  nameHi    String    @map("name_hi")
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id                String         @id @default(uuid())
  barcode           String?        @unique
  nameEn            String         @map("name_en")
  nameHi            String?        @map("name_hi")
  imageUrl          String?        @map("image_url")
  categoryId        String         @map("category_id")
  category          Category       @relation(fields: [categoryId], references: [id])
  baseUnit          String         @default("piece") @map("base_unit")
  allowDecimalQty   Boolean        @default(false) @map("allow_decimal_qty")
  lowStockThreshold Decimal        @default(0) @db.Decimal(12, 3) @map("low_stock_threshold")
  totalStockBase    Decimal        @default(0) @db.Decimal(12, 3) @map("total_stock_base")
  minAlertQty       Int            @default(0) @map("min_alert_qty")
  units             ProductUnit[]
  batches           ProductBatch[]
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@index([barcode])
  @@index([nameEn])
  @@index([nameHi])
  @@index([categoryId])
  @@map("products")
}

model ProductUnit {
  id              String         @id @default(uuid())
  productId       String         @map("product_id")
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameEn          String         @map("name_en")
  nameHi          String?        @map("name_hi")
  factorToBase    Decimal        @db.Decimal(12, 4) @map("factor_to_base")
  isPurchaseUnit  Boolean        @default(false) @map("is_purchase_unit")
  isSellUnit      Boolean        @default(true) @map("is_sell_unit")
  marginPercent   Decimal        @default(0) @db.Decimal(8, 2) @map("margin_percent")
  sellingPrice    Decimal        @default(0) @db.Decimal(10, 2) @map("selling_price")
  priceOverride   Decimal?       @db.Decimal(10, 2) @map("price_override")
  minQty          Decimal        @default(1) @db.Decimal(12, 3) @map("min_qty")
  qtyStep         Decimal        @default(1) @db.Decimal(12, 3) @map("qty_step")
  barcode         String?
  sortOrder       Int            @default(0) @map("sort_order")
  purchaseBatches ProductBatch[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([productId, nameEn])
  @@index([productId])
  @@index([barcode])
  @@map("product_units")
}

model ProductBatch {
  id                   String                       @id @default(uuid())
  productId            String                       @map("product_id")
  product              Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseUnitId       String?                      @map("purchase_unit_id")
  purchaseUnit         ProductUnit?                 @relation(fields: [purchaseUnitId], references: [id], onDelete: SetNull)
  purchaseQty          Decimal?                     @db.Decimal(12, 3) @map("purchase_qty")
  purchasePricePerUnit Decimal?                     @db.Decimal(14, 4) @map("purchase_price_per_unit")
  qtyReceivedBase      Decimal                      @default(0) @db.Decimal(12, 3) @map("qty_received_base")
  qtyRemainingBase     Decimal                      @default(0) @db.Decimal(12, 3) @map("qty_remaining_base")
  costPerBase          Decimal                      @default(0) @db.Decimal(14, 4) @map("cost_per_base")
  purchaseCost         Decimal                      @default(0) @db.Decimal(10, 2) @map("purchase_cost")
  sellingPrice         Decimal                      @default(0) @db.Decimal(10, 2) @map("selling_price")
  initialStock         Int                          @default(0) @map("initial_stock")
  currentStock         Int                          @default(0) @map("current_stock")
  vendor               String?
  receivedAt           DateTime                     @default(now()) @map("received_at")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")
  allocations          InvoiceItemBatchAllocation[]

  @@index([productId])
  @@index([productId, receivedAt])
  @@index([createdAt])
  @@map("product_batches")
}

model Customer {
  id            String         @id @default(uuid())
  // Phone and name fields contain AES-256-GCM ciphertext; phoneLookup is a keyed HMAC for exact lookup.
  phone         String         @unique
  phoneLookup   String?        @unique @map("phone_lookup")
  name          String?
  firstName     String?        @map("first_name")
  totalOrders   Int            @default(0) @map("total_orders")
  lifetimeSpend Decimal        @default(0) @db.Decimal(10, 2) @map("lifetime_spend")
  lastPurchase  DateTime?      @map("last_purchase")
  tags          String[]       @default([])
  lastCategory  String?        @map("last_category")
  invoices      SalesInvoice[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([phone])
  @@map("customers")
}

model SalesInvoice {
  id             String               @id @default(uuid())
  invoiceNo      String               @unique @map("invoice_no")
  idempotencyKey String?              @unique @map("idempotency_key")
  requestHash    String?              @map("request_hash")
  customerId     String?              @map("customer_id")
  customer       Customer?            @relation(fields: [customerId], references: [id])
  customerPhone  String?              @map("customer_phone")
  customerName   String?              @map("customer_name")
  subtotal       Decimal              @default(0) @db.Decimal(10, 2) @map("subtotal")
  discountAmount Decimal             @default(0) @db.Decimal(10, 2) @map("discount_amount")
  totalAmount    Decimal              @db.Decimal(10, 2) @map("total_amount")
  totalProfit    Decimal              @db.Decimal(10, 2) @map("total_profit")
  paymentMode    String               @map("payment_mode") // CASH, UPI, CARD, KHATA
  waStatus       String               @default("PENDING") @map("wa_status") // PENDING, QUEUED, SENT, FAILED
  items          InvoiceItem[]
  refunds        SalesInvoiceRefund[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([invoiceNo])
  @@index([customerPhone])
  @@map("sales_invoices")
}

model InvoiceItem {
  id              String                       @id @default(uuid())
  invoiceId       String                       @map("invoice_id")
  invoice         SalesInvoice                 @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId       String                       @map("product_id")
  productName     String                       @map("product_name")
  unitName        String                       @default("piece") @map("unit_name")
  factorToBase    Decimal                      @default(1) @db.Decimal(12, 4) @map("factor_to_base")
  qtyInUnit       Decimal                      @default(1) @db.Decimal(12, 3) @map("qty_in_unit")
  qtyBase         Decimal                      @default(1) @db.Decimal(12, 3) @map("qty_base")
  refundedQtyBase Decimal                      @default(0) @db.Decimal(12, 3) @map("refunded_qty_base")
  unitPrice       Decimal                      @default(0) @db.Decimal(10, 2) @map("unit_price")
  grossLineTotal  Decimal                      @default(0) @db.Decimal(10, 2) @map("gross_line_total")
  discountAmount  Decimal                      @default(0) @db.Decimal(10, 2) @map("discount_amount")
  lineTotal       Decimal                      @default(0) @db.Decimal(10, 2) @map("line_total")
  cogs            Decimal                      @default(0) @db.Decimal(10, 2)
  profit          Decimal                      @default(0) @db.Decimal(10, 2)
  batchId         String?                      @map("batch_id")
  quantity        Int                          @default(1)
  unitCost        Decimal                      @default(0) @db.Decimal(10, 2) @map("unit_cost")
  unitSalePrice   Decimal                      @default(0) @db.Decimal(10, 2) @map("unit_sale_price")
  lineProfit      Decimal                      @default(0) @db.Decimal(10, 2) @map("line_profit")
  allocations     InvoiceItemBatchAllocation[]
  refunds         SalesInvoiceRefund[]
  createdAt       DateTime                     @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoiceItemBatchAllocation {
  id            String       @id @default(uuid())
  invoiceItemId String       @map("invoice_item_id")
  invoiceItem   InvoiceItem  @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  batchId       String       @map("batch_id")
  batch         ProductBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  qtyBase       Decimal      @db.Decimal(12, 3) @map("qty_base")
  costPerBase   Decimal      @db.Decimal(14, 4) @map("cost_per_base")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([invoiceItemId])
  @@index([batchId])
  @@map("invoice_item_batch_allocations")
}

model SalesInvoiceRefund {
  id             String       @id @default(uuid())
  invoiceId      String       @map("invoice_id")
  invoice        SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItemId  String       @map("invoice_item_id")
  invoiceItem    InvoiceItem  @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  idempotencyKey String?      @unique @map("idempotency_key")
  refundNo       String       @unique @map("refund_no")
  qtyInUnit      Decimal      @db.Decimal(12, 3) @map("qty_in_unit")
  qtyBase        Decimal      @db.Decimal(12, 3) @map("qty_base")
  refundAmount   Decimal      @db.Decimal(10, 2) @map("refund_amount")
  subtotalAmount Decimal      @default(0) @db.Decimal(10, 2) @map("subtotal_amount")
  discountReversed Decimal    @default(0) @db.Decimal(10, 2) @map("discount_reversed")
  cogsReversed   Decimal      @db.Decimal(10, 2) @map("cogs_reversed")
  profitReversed Decimal      @db.Decimal(10, 2) @map("profit_reversed")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([invoiceItemId])
  @@map("sales_invoice_refunds")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("CASHIER") // ADMIN, CASHIER
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model UpiAccount {
  id        String   @id @default(uuid())
  upiId     String   @unique @map("upi_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("upi_accounts")
}

model ShopSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shop_settings")
}
