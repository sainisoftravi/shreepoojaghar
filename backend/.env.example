NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shreepooja?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shreepooja?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Customer and invoice name/phone encryption key (generate with: openssl rand -hex 32)
PII_ENCRYPTION_KEY=""

# Invoice branding (the shop logo is bundled at assets/store-logo.png)
STORE_NAME="Shree Pooja Ghar"
STORE_ADDRESS="Ajmer, Rajasthan, India"
STORE_PHONE=""

# WhatsApp Integration
WHATSAPP_PROVIDER="meta"
WHATSAPP_API_URL="https://graph.facebook.com/v17.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# CORS
CORS_ORIGIN="*"
