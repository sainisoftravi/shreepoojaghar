{
  "name": "shree-pooja-ghar-backend",
  "version": "1.0.0",
  "description": "Shree Pooja Ghar POS and Inventory Backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "prisma migrate deploy && node prisma/encrypt-customer-pii.js && node src/server.js",
    "dev": "prisma migrate deploy && node prisma/encrypt-customer-pii.js && nodemon src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:encrypt-customer-pii": "node prisma/encrypt-customer-pii.js",
    "db:seed": "node prisma/seed.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^4.0.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.4.0",
    "pg": "^8.11.0",
    "pino": "^8.14.1",
    "pino-http": "^8.3.3",
    "puppeteer": "^25.12.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
